// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Biography {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  profileImage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("biographies")
}

model Repertoire {
  id            String   @id @default(cuid())
  title         String
  composer      String
  year          Int?
  duration      Int?     // Minutes
  description   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("repertoires")
}

model Concert {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  date          DateTime
  location      String
  venue         String
  time          String?
  isUpcoming    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("concerts")
}

model Photo {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  imageUrl      String
  category      String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("photos")
}

model Video {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  youtubeId     String
  category      String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("videos")
}

model ContactMessage {
  id            String   @id @default(cuid())
  name          String
  email         String
  message       String   @db.Text
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("contact_messages")
}
